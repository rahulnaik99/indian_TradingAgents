# Existing market-data provider remains FYERS. Do not put Kite market data here.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# Hosted Kite MCP endpoint. Python connects directly; no local MCP server is started.
# The hosted service can restrict tool availability. Authorize this Python client separately.
KITE_MCP_URL=https://mcp.kite.trade/mcp
KITE_GTT_TOOL_NAME=place_gtt_order

# Live trading is OFF unless explicitly enabled.
PLACE_ORDER=false
AMOUNT_PER_TRADE=10000
MAX_RISK_PER_TRADE=500
KITE_PRODUCT=CNC
KITE_ORDER_TYPE=LIMIT

# Safety: keep enabled until entry-fill reconciliation automatically arms OCO exits.
REQUIRE_STOP_LOSS=true
ALLOW_UNPROTECTED_ENTRY_GTT=false
